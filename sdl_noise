#define SDL_ENABLE_OLD_NAMES
#include<SDL3/SDL_oldnames.h>
#define SDL_MAIN_USE_CALLBACKS 1
#include<SDL3/SDL.h>
#include<SDL3/SDL_main.h>
#include<iostream>
static SDL_Window* window;
static SDL_Renderer* renderer;
SDL_FPoint points[800*640];
int k = 0;
SDL_AppResult SDL_AppInit(void** appstate, int argc, char* argv[]) 
{
	int* rand = new int[800, 640];
	for (int i = 0; i < 800; i++)
		for (int j = 0; j < 640; j++)
			rand[i,j] = SDL_rand(2);
	SDL_SetRenderDrawColor(renderer, 0, 255, 0, 255);
	
	for (int i = 0; i < 800; i++)
		for(int j = 0; j < 640; j++)
			if (rand[i,j]) points[k++] = {(float)i,(float)j};	

	SDL_CreateWindowAndRenderer("SDL3 Game", 840, 640, 0, &window, &renderer);
	
	const char* driver = "nvidia";
	SDL_GPUDevice* device = SDL_CreateGPUDevice(SDL_GPU_SHADERFORMAT_SPIRV, 1, driver);	
	SDL_Log(SDL_GetGPUDeviceDriver(device));
	return SDL_APP_CONTINUE;
}

SDL_AppResult SDL_AppIterate(void* appstate) 
{
	
	SDL_FPoint rpoints[k];
	for (int i = 0; i < k; i++)
		rpoints[i] = points[i];
	SDL_ClaimWindowForGPUDevice(device, window)
	SDL_RenderPoints(renderer, rpoints, SDL_arraysize(rpoints));
	SDL_RenderPresent(renderer);	
    
	return SDL_APP_CONTINUE;
}
SDL_AppResult SDL_AppEvent(void* appstate, SDL_Event* event)
{
	if (event->type == SDL_EVENT_QUIT)
	{
		return SDL_APP_SUCCESS;
	}
	return SDL_APP_CONTINUE;
}

void SDL_AppQuit(void* appstate, SDL_AppResult result)
{

}
